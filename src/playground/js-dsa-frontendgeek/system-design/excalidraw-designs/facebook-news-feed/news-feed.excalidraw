        "gfeOriginalY": 2500,
        "gfeOriginalText": "GET /feed?cursor={cursor}&limit=20\n→ { items, nextCursor, hasNext }\n\nGET /stories/{id}/comments?cursor=…\n→ { items, nextCursor, hasNext }\n\nGET /users/{id}\n→ User"
      },
      "text": "Authenticated session determines viewer identity\n\nGET /feed?cursor={cursor}&count=20&direction=older|newer\n→ { posts, users, media, olderCursor, newerCursor, generation }\n\nGET /posts/{postId} → canonical Post",
      "fontSize": 18,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Authenticated session determines viewer identity\n\nGET /feed?cursor={cursor}&count=20&direction=older|newer\n→ { posts, users, media, olderCursor, newerCursor, generation }\n\nGET /posts/{postId} → canonical Post",
      "autoResize": false,
