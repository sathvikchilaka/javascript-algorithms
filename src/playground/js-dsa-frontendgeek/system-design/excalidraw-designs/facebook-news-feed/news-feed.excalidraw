    {
      "id": "MQkEfcmb6p9qNI4Ojsmuh",
      "type": "text",
      "x": -508.88515679925933,
      "y": -704.6452404262371,
      "width": 466.4247082457231,
      "height": 368.15999999999997,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 2030267990,
      "version": 1636,
      "versionNonce": 588789526,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789508779250,
      "created": 1789415923909,
      "link": null,
      "locked": false,
      "text": "Execution Order\n1. General Requirements\n2. Specific Requirements\n3. Components Architecture\n4. Architecture / High-Level Design\n5. Data Entities / Models\n6. Data API\n7. Client Data Store\n8. Infinite Scroll\n8A. Error & Empty States\n9. Optimization\n10. Accessibility",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Execution Order\n1. General Requirements\n2. Specific Requirements\n3. Components Architecture\n4. Architecture / High-Level Design\n5. Data Entities / Models\n6. Data API\n7. Client Data Store\n8. Infinite Scroll\n8A. Error & Empty States\n9. Optimization\n10. Accessibility",
      "autoResize": false,
      "lineHeight": 1.18,
      "labelPosition": null,
      "customData": {
        "gfeOriginalText": "Execution Order\n1. General Requirements\n2. Specific Requirements\n3. Components Architecture\n4. Data Entities / Models\n5. Data API\n6. Client Data Store\n7. Infinite Scroll\n7A. Error & Empty States\n8. Optimization\n9. Accessibility"
      }
    },
    {
      "id": "g1ztiXGTniGUz0DbggHOE",
      "type": "text",
      "x": -974.6805103462989,
      "y": -220.8842826166176,
      "width": 822.5108142597103,
      "height": 162.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 990106186,
      "version": 353,
      "versionNonce": 1531498570,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789508779250,
      "created": 1789416211477,
      "link": null,
      "locked": false,
      "text": "General Requirements:\n1. Browse a personalized feed\n2. React to and create posts\n3. Load older posts\n4. Surface newer posts without disrupting reading",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "General Requirements:\n1. Browse a personalized feed\n2. React to and create posts\n3. Load older posts\n4. Surface newer posts without disrupting reading",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "customData": {
        "gfeOriginalText": "General Requirements:\n1. Infinite scroll for the news feed\n2. User can share a story\n3. User can post, comment, react, and attach media"
      }
    },
    {
      "id": "EC_rf08Rq9mc1ZKGlbCIo",
      "type": "text",
      "x": -127.77545505652873,
      "y": -220.5454378294453,
      "width": 822.5108142597103,
      "height": 162.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 748559818,
      "version": 895,
      "versionNonce": 1990373718,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789508779250,
      "created": 1789416562288,
      "link": null,
      "locked": false,
      "text": "Specific Requirements:\n1. Web-first, long-lived signed-in session\n2. Text and image posts\n3. Comments/shares are extensions\n4. Accessible and responsive across devices",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Specific Requirements:\n1. Web-first, long-lived signed-in session\n2. Text and image posts\n3. Comments/shares are extensions\n4. Accessible and responsive across devices",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "customData": {
        "gfeOriginalText": "Specific Requirements:\n1. Support users with disabilities\n2. Work across a wide range of devices"
      }
    },
